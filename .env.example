APP_NAME="FGPOOL Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_URL=http://localhost:8000

# --- Frontend baglanti adresleri ---
# Local: fgpool-web Next.js dev server
FRONTEND_LOCAL_URL=http://localhost:3000
# Test/production: Vercel domainleri
FRONTEND_STAGING_URL=
FRONTEND_PRODUCTION_URL=https://fgpool.com

# Cok dilli yapi
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
ACTIVE_LOCALES=tr,en,ar

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Veritabani (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fgpool_admin
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local
LIVEWIRE_TEMPORARY_FILE_UPLOAD_RULES=required|file
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DIRECTORY=livewire-tmp

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@fgpool.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sanctum / SPA & Next.js frontend ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:3001,127.0.0.1,127.0.0.1:3000,127.0.0.1:3001,fgpool.com,www.fgpool.com,admin.fgpool.com
# Not: SESSION_DOMAIN yukarida (satir 36) zaten tanimli. Local gelistirmede
# null birakin; production'da gercek domain'e gecerken oradaki degeri
# ".fgpool.com" gibi guncelleyin. Ayni degiskeni iki kez tanimlamayin -
# .env dosyalarinda sonraki tanim onceki degeri gecersiz kilar ve
# 127.0.0.1/localhost uzerinde cookie'nin gonderilmemesine (CSRF/419 "page
# expired" hatasina) yol acar.

# --- CORS: Next.js frontend origin'leri (virgulle ayirin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://fgpool.com,https://www.fgpool.com
# Vercel preview domainleri icin opsiyonel regex. Ornek:
# CORS_ALLOWED_ORIGIN_PATTERNS=^https://fgpool-web-.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_PATTERNS=

# --- Upload limitleri (KB) ---
MEDIA_MAX_IMAGE_SIZE=5120
MEDIA_MAX_DOCUMENT_SIZE=20480

# --- Filament ---
FILAMENT_PATH=admin
FILAMENT_DOMAIN=

# --- Seed admin kullanıcısı (php artisan db:seed) ---
ADMIN_SEED_EMAIL=admin@fgpool.com
ADMIN_SEED_PASSWORD=password
